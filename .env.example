# ===== Netlify (the website). These are safe to expose in the browser. =====
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=   # the sb_publishable_... key from Supabase (older projects: the anon key in VITE_SUPABASE_ANON_KEY)
VITE_API_URL=                    # your server address, e.g. https://api.129.150.1.2.sslip.io (no slash at the end)
VITE_LS_CHECKOUT_PLUS=           # Lemon Squeezy checkout link for Plus
VITE_LS_CHECKOUT_PRO=            # Lemon Squeezy checkout link for Pro
VITE_LS_PORTAL_URL=              # optional: your Lemon Squeezy customer portal link
VITE_SENTRY_DSN=                 # optional: error reports (Sentry or GlitchTip)

# ===== Your server on Coolify. NEVER put these in Netlify or in code. =====
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=        # the sb_publishable_... key
SUPABASE_SECRET_KEY=             # the sb_secret_... key. Secret: full access to your database
ALLOWED_ORIGINS=                 # your Netlify addresses, comma between them, e.g. https://earshelf.netlify.app,https://tapestry.netlify.app
LEMON_SQUEEZY_SIGNING_SECRET=
LS_VARIANT_EARSHELF_PLUS=
LS_VARIANT_EARSHELF_PRO=
LS_VARIANT_TAPESTRY_PLUS=        # Tapestry Plus variant id from Lemon Squeezy
LS_VARIANT_TAPESTRY_PRO=
TAPESTRY_TRANSLATION_ID=engwebp  # World English Bible. Change only after reading a translation's license
TAPESTRY_ADMIN_USER_IDS=         # your own Supabase user id (lets you press Owner setup in Tapestry's Profile)
# (TTS_KOKORO_HOSTPORT is already set to kokoro:8880 by deploy/docker-compose.yml)
ELEVENLABS_API_KEY=              # premium voices
ELEVENLABS_MODEL=                # default eleven_multilingual_v2
ELEVENLABS_VOICE_IDS=            # optional: comma separated voice ids to offer
ELEVENLABS_CONCURRENCY=          # default 2; lower if you see busy errors
EMBED_API_KEY=                   # search by meaning. An OpenAI key works
EMBED_BASE_URL=                  # only for Ollama or another OpenAI-style server
EMBED_MODEL=                     # default text-embedding-3-small (must give 384 numbers)
SENTRY_DSN=                      # optional: server error reports
TTS_OPENAI_BASE_URL=             # e.g. https://api.openai.com/v1 or your own Kokoro server
TTS_OPENAI_API_KEY=
TTS_OPENAI_MODEL=                # e.g. tts-1 or kokoro
TTS_OPENAI_VOICES=               # comma separated, e.g. alloy,nova,onyx
TTS_OPENAI_FORMAT=pcm
EDGE_TTS_ENABLED=false           # true = Edge voices for the user ids below only
EDGE_TTS_ALLOWED_USER_IDS=
AI_PROVIDER=anthropic            # or openai-compatible
AI_API_KEY=
AI_MODEL=claude-haiku-4-5-20251001
AI_BASE_URL=                     # only for openai-compatible / Ollama, e.g. http://ollama:11434/v1
